# konvo-admin-cli — operator config. Copy to .env and fill in.

# Your operator name. Used in audit log entries to attribute actions.
KONVO_OPERATOR=siafa

# Production VPS host. SSH connections + tunnels go here.
KONVO_PROD_HOST=root@5.78.237.171

# SSH private key path. Defaults to ~/.ssh/id_ed25519 if unset.
KONVO_SSH_KEY=

# Direct Postgres connection — empty by default; runbooks open ad-hoc
# tunnels via the supabase-db container. Set this to a real DSN if you
# want the CLI to talk to a tunneled port instead.
KONVO_DB_URL=

# Stripe secret key for refund + key-rotation runbooks. Use the LIVE
# key (sk_live_...) for prod operations. Test key (sk_test_...) is
# fine for dry-runs.
# Required by: refund-revoke, rotate-stripe-keys.
KONVO_STRIPE_SECRET_KEY=

# Worker base URL. Used by run-signup-load-test runbook.
KONVO_WORKER_URL=https://worker.thekonvo.com

# Loadtest admin secret. Must match LOADTEST_ADMIN_SECRET on the
# worker (set on VPS at /root/.konvo-prod/loadtest-admin-secret.txt).
# Required by: run-signup-load-test.
KONVO_LOADTEST_ADMIN_SECRET=
