# konvo-admin-cli — operator config. Copy to .env and fill in.

# Your operator name. Used in audit log entries to attribute actions.
KONVO_OPERATOR=siafa

# Production VPS host. SSH connections + tunnels go here.
KONVO_PROD_HOST=root@5.78.237.171

# SSH private key path. Defaults to ~/.ssh/id_ed25519 if unset.
KONVO_SSH_KEY=

# Direct Postgres connection — empty by default; runbooks open ad-hoc
# tunnels via the supabase-db container. Set this to a real DSN if you
# want the CLI to talk to a tunneled port instead.
KONVO_DB_URL=
